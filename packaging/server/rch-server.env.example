RCH_BIND=127.0.0.1:8000
RCH_DB_PATH=/var/lib/rch/rch_state.sqlite3
RCH_CONFIG_PATH=/etc/rch/config.ini
RCH_RETICULUMD_DB_PATH=/var/lib/rch/reticulum.db
RCH_LXMF_ZMQ_COMMAND=tcp://localhost:9100
RCH_LXMF_ZMQ_RESPONSE=tcp://localhost:9101
# Optional when a UI bundle is deployed beside the server package.
# RCH_UI_DIST_PATH=/opt/rch/ui
# Leave empty for authorized local first-run setup, or supply a unique random key.
# Configured credentials are required for every protected route, including loopback.
RTH_API_KEY=
# Set the exact UI origin when using a separate UI host or HTTPS reverse proxy.
# RCH_ALLOWED_ORIGINS=https://rch.example.org
